# Copy to .env (never commit .env). No credentials belong in this file:
# database passwords are Compose secret FILES under COLLECTOR_SECRETS_DIR.
# Generate them with: scripts/init-secrets.sh

# Compose project (must stay unique on this host; blueprint §5).
COMPOSE_PROJECT_NAME=cyber-web-collector
APP_VERSION=0.1.0

# Confirmed persistent ext4 path on the VM (run scripts/preflight.sh first).
# Subdirectories: postgres/, artifacts/, input/, backups/
COLLECTOR_DATA_DIR=/srv/cyber-web-collector
COLLECTOR_SECRETS_DIR=./secrets

# Shared secret path between browser-worker and browser-engine (>= 24 random chars).
# Example: openssl rand -hex 24
BROWSER_SERVER_PATH=replace-with-random-hex-token

# Ports the gateway may contact. Must match scope.allowed_ports in config/policy.yaml.
GATEWAY_ALLOWED_PORTS=80,443
# Extra CIDRs to deny (e.g. this VM's own public address, provider metadata ranges).
GATEWAY_EXTRA_DENY_CIDRS=

# Free-text label recorded with every attempt: which public vantage the gateway uses.
# A local gateway does NOT change the VM's public IP or country.
EGRESS_VANTAGE_LABEL=vm-public-ip-via-local-gateway

# Retention deletes only when explicitly enabled; case holds always win.
RETENTION_DELETE_ENABLED=false

LOG_LEVEL=info

# Paid/hosted providers and model APIs are intentionally ABSENT in the baseline.
# Do not add provider API keys here.
