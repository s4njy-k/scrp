    "jsqr": "1.4.0",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "playwright-core": "1.56.1",
    "pngjs": "7.0.0",
    "tldts": "7.4.16",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
